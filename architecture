voice_assistant/
├── main.py              # Точка входа: цикл слушания → обработка → ответ
├── requirements.txt     # Зависимости
│
├── detector.py      # OpenWakeWord: загрузка модели, прослушивание микрофона
├── recognizer.py    # Vosk: преобразование аудио в текст
├── engine.py        # Regex + словарь: определение intent и entities
├── intents.yaml     # Описание всех команд и их синонимов
├── speaker.py       # Piper: озвучивание ответов
│
├── skills/
│   ├── base.py          # Базовый класс для всех скиллов
│   ├── weather.py       # Пример: погода (если есть локальный API)
│   ├── timer.py         # Пример: таймер/будильник
│   └── system.py        # Пример: громкость, время, дата
│
└── models/              # Модели